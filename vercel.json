{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "framework": null,
  "buildCommand": "npm run build:vercel",
  "outputDirectory": "public",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains; preload" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin-allow-popups" },
        { "key": "Cross-Origin-Resource-Policy", "value": "same-origin" },
        { "key": "X-DNS-Prefetch-Control", "value": "off" },
        { "key": "X-Permitted-Cross-Domain-Policies", "value": "none" },
        { "key": "Permissions-Policy", "value": "camera=(self), microphone=(), geolocation=(self)" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' https://esm.sh https://link.msgsndr.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://images.unsplash.com; connect-src 'self' https://esm.sh https://link.msgsndr.com https://*.supabase.co wss://*.supabase.co; manifest-src 'self'; worker-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'" }
      ]
    },
    {
      "source": "/app.js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/styles.css",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/navigation.css",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/public-config.js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=300, must-revalidate" }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    }
  ],
  "crons": [
    { "path": "/api/wallet-reminders", "schedule": "0 13 * * *" }
  ],
  "rewrites": [
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/register", "destination": "/index.html" },
    { "source": "/offline", "destination": "/offline.html" },
    { "source": "/login", "destination": "/index.html" },
    { "source": "/home", "destination": "/index.html" },
    { "source": "/dashboard", "destination": "/index.html" },
    { "source": "/planning", "destination": "/index.html" },
    { "source": "/planning/:path*", "destination": "/index.html" },
    { "source": "/itinerary", "destination": "/index.html" },
    { "source": "/itinerary/:path*", "destination": "/index.html" },
    { "source": "/events", "destination": "/index.html" },
    { "source": "/travel", "destination": "/index.html" },
    { "source": "/travel/:path*", "destination": "/index.html" },
    { "source": "/transportation", "destination": "/index.html" },
    { "source": "/transportation/:path*", "destination": "/index.html" },
    { "source": "/wallet", "destination": "/index.html" },
    { "source": "/wallet/:path*", "destination": "/index.html" },
    { "source": "/chat", "destination": "/index.html" },
    { "source": "/chat/:path*", "destination": "/index.html" },
    { "source": "/important-info", "destination": "/index.html" },
    { "source": "/important-info/:path*", "destination": "/index.html" },
    { "source": "/explore", "destination": "/index.html" },
    { "source": "/explore/:path*", "destination": "/index.html" },
    { "source": "/trips", "destination": "/index.html" },
    { "source": "/trips/:path*", "destination": "/index.html" },
    { "source": "/messages", "destination": "/index.html" },
    { "source": "/messages/:path*", "destination": "/index.html" },
    { "source": "/memories", "destination": "/index.html" },
    { "source": "/memories/:path*", "destination": "/index.html" },
    { "source": "/corporate", "destination": "/index.html" },
    { "source": "/corporate/:path*", "destination": "/index.html" },
    { "source": "/profile", "destination": "/index.html" },
    { "source": "/profile/:path*", "destination": "/index.html" },
    { "source": "/settings", "destination": "/index.html" },
    { "source": "/settings/:path*", "destination": "/index.html" }
  ]
}
